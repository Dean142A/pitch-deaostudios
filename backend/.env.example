# =============================================
# Deao Studios Pitch Deck Generator - Backend
# SECURITY-HARDENED .env.example
# =============================================

# Server
PORT=4000
NODE_ENV=production
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE_MIN_32_CHARS
FRONTEND_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/deao_pitch

# AI Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# Active AI Provider: "gemini" | "anthropic" | "auto"
AI_PROVIDER=auto

# Storage
STORAGE_PATH=../storage
UPLOAD_MAX_SIZE_MB=10
DECK_EXPIRY_DAYS=7

# Queue
MAX_CONCURRENT_GENERATIONS=2

# Admin setup (used by migrate.js ONLY — remove after first run)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=YourSecurePassword123
